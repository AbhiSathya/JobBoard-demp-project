# Copy to .env and adjust as needed. All values below are safe non-secret defaults
# except JWT_SECRET and OPENROUTER_API_KEY, which you should set yourself.

DATABASE_URL=sqlite:///./jobboard.db

# Change this for any real deployment — never commit a real secret here.
JWT_SECRET=dev-secret-change-me-please-use-a-long-random-value-32bytes
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# Optional. AI matching works fully without this key (deterministic fallback).
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=8.0

CORS_ORIGINS=["http://localhost:5173"]
